{
  "framework": "nextjs",
  "buildCommand": "next build",
  "regions": ["bom1"],
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/daily-summary?pass=2",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/daily-summary?pass=3",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/demo-cleanup",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "5 3 * * *"
    }
  ]
}
